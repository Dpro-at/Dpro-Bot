{
  "name": "@agent-player/desktop",
  "productName": "Girru",
  "version": "1.3.2",
  "private": true,
  "description": "Girru desktop app",
  "license": "MIT",
  "author": "Mohamed Alarade",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --import ../../scripts/test-temp-root.mjs --test test/*.test.cjs",
    "stage": "node scripts/stage-payload.cjs",
    "stage:code": "node scripts/stage-nabu.cjs",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist:dir": "electron-builder --dir --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.dpro.desktop",
    "productName": "Girru",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "payload",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "payload/node_modules",
        "to": "payload/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "nabu-runtime",
        "to": "nabu-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "publish": null,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Girru uses the microphone only when you press the microphone button to dictate a message."
      },
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "executableName": "Girru"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  }
}
